{
  "id": "trivia-night",
  "contexts": ["household", "shared_space"],
  "name": "Trivia Night",
  "version": "1.0.0",
  "description": "Host a family trivia round: write questions with hidden answers, everyone submits sealed guesses, then close the round to reveal, grade, and crown a winner.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "games",
  "tags": ["trivia", "quiz", "game", "family", "party"],
  "icon": "🧠",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "row_policies": {
    "rounds": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true
    },
    "questions": {
      "kind": "inherit_visibility",
      "fk_column": "round_id",
      "parent_table": "rounds",
      "writer_column": "created_by",
      "insert_only_by_parent_column_member": "created_by",
      "column_read_acls": {
        "correct_answer": { "visible_to": ["owner"] }
      }
    },
    "guesses": {
      "kind": "sealed_until",
      "fk_column": "round_id",
      "parent_table": "rounds",
      "writer_column": "member_id",
      "parent_status_column": "status",
      "visible_parent_status_values": ["closed"],
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["question_id"],
        "limit": 1
      },
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed"]
      }
    },
    "gradings": {
      "kind": "inherit_visibility",
      "fk_column": "round_id",
      "parent_table": "rounds",
      "writer_column": "graded_by",
      "insert_only_by_parent_column_member": "created_by"
    }
  },
  "nav": { "label": "Trivia" },
  "resource_limits": {
    "max_db_bytes": 52428800
  }
}
